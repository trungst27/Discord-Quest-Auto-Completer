DISCORD_TOKEN=
# Optional: sync slash commands to one guild instantly
# (right-click server -> Copy Server ID)
GUILD_ID=
# Alias used by botkeep.cloud panels
DISCORD_GUILD_ID=
# Comma-separated user IDs allowed to run owner-only commands.
# Empty = nobody. Your own ID: Discord -> Developer Mode -> Copy User ID
OWNER_IDS=
# USER token (not the bot token) for /scan and /quest.
# Quest endpoints are user-scoped: /quests/@me answers 401 to a bot token.
# Leave empty to keep /scan and /quest disabled; they then print setup steps.
# Discord.com/app -> Ctrl+Shift+I -> Network -> header "authorization"
QUEST_TOKEN=
