DISCORD_TOKEN=
# Optional: sync slash commands to one guild instantly
# (right-click server -> Copy Server ID)
GUILD_ID=
# Alias used by botkeep.cloud panels
DISCORD_GUILD_ID=
# Comma-separated user IDs allowed to run owner-only commands.
# Empty = nobody. Your own ID: Discord -> Developer Mode -> Copy User ID
OWNER_IDS=
# Optional: encryption key for tokens users save with /quest login.
# Leave empty and the bot generates quest-secret.key next to itself.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored user token unreadable; users log in again.
QUEST_SECRET=
# Optional: HTTP health endpoint for uptime monitors (UptimeRobot, BetterStack…).
# Leave empty to disable. Set to a port the panel exposes, e.g. 8080.
# GET /health -> {"status":"ok","workers":1,"uptime_s":3600,...}
HEALTH_PORT=
# Optional: outbound heartbeat — works without any open port (healthchecks.io…).
# Bot POSTs its status here every HEALTHCHECK_INTERVAL seconds (default 300).
HEALTHCHECK_URL=
HEALTHCHECK_INTERVAL=
